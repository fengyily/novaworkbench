#!/bin/bash
# User-data script — runs once on first boot as root.
# Creates the deploy user, installs docker, configures sudo + docker group
# membership so the GitHub Actions SSH deploy can talk to the daemon
# without manual intervention.
set -euo pipefail

DEPLOY_USER="${deploy_user}"

# 1. deploy user + sudo + SSH authorized_keys
if ! id "${DEPLOY_USER}" >/dev/null 2>&1; then
  useradd -m -s /bin/bash "${DEPLOY_USER}"
fi
echo "${DEPLOY_USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${DEPLOY_USER}
chmod 440 /etc/sudoers.d/90-${DEPLOY_USER}

# Place the GitHub Actions SSH public key (passed via Terraform's
# ssh_public_key variable into the key_pair resource; we mirror it
# into the user's authorized_keys so the initial Terraform-managed
# remote-exec + subsequent GitHub deploys both work).
mkdir -p /home/${DEPLOY_USER}/.ssh
chmod 700 /home/${DEPLOY_USER}/.ssh
cp /root/.ssh/authorized_keys /home/${DEPLOY_USER}/.ssh/authorized_keys 2>/dev/null || true
chown -R ${DEPLOY_USER}:${DEPLOY_USER} /home/${DEPLOY_USER}/.ssh
chmod 600 /home/${DEPLOY_USER}/.ssh/authorized_keys 2>/dev/null || true

# 2. Install docker (Ubuntu 22.04 jammy repo)
if ! command -v docker >/dev/null 2>&1; then
  apt-get update
  apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu jammy stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update
  apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io
fi

# 3. Compose v2 (CLI plugin form)
if ! docker compose version >/dev/null 2>&1; then
  mkdir -p /usr/local/lib/docker/cli-plugins
  curl -SL https://github.com/docker/compose/releases/download/v2.27.1/docker-compose-linux-x86_64 \
    -o /usr/local/lib/docker/cli-plugins/docker-compose
  chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
fi

# 4. Deploy user joins the docker group so docker.sock is reachable
#    without sudo.
usermod -aG docker "${DEPLOY_USER}"

# 5. SSH: allow key-only auth, restart
sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
systemctl restart ssh || systemctl restart sshd || true

echo "user_data: ready for ${DEPLOY_USER}" > /var/log/nova-userdata.log